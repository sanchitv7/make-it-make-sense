{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-start.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/deny-no-verify.sh",
        "matcher": "git\\s+(commit|push)",
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/require-pr-up-to-date.sh",
        "matcher": "\\bgh\\b",
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/stop-nudge.sh",
        "loop_limit": 1
      }
    ]
  }
}
